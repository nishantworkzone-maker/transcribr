{
  "version": 2,
  "builds": [
    { "src": "api/*.js",         "use": "@vercel/node" },
    { "src": "api/payment/*.js", "use": "@vercel/node" },
    { "src": "server.js",        "use": "@vercel/node" },
    { "src": "*.html",           "use": "@vercel/static" },
    { "src": "theme.js",         "use": "@vercel/static" },
    { "src": "theme-vars.css",   "use": "@vercel/static" },
    { "src": "lib/*.js",         "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/config",              "dest": "/api/config.js" },
    { "src": "/api/audio",               "dest": "/api/audio.js" },
    { "src": "/api/blob-upload",         "dest": "/api/blob-upload.js" },
    { "src": "/api/payment/create-order","dest": "/api/payment/create-order.js" },
    { "src": "/api/payment/verify",      "dest": "/api/payment/verify.js" },
    { "src": "/api/(.*)",                "dest": "/server.js" },
    { "src": "/login.html",              "dest": "/login.html" },
    { "src": "/dashboard.html",          "dest": "/dashboard.html" },
    { "src": "/transcript.html",         "dest": "/transcript.html" },
    { "src": "/app.html",                "dest": "/app.html" },
    { "src": "/pricing.html",            "dest": "/pricing.html" },
    { "src": "/refund.html",             "dest": "/refund.html" },
    { "src": "/contact.html",            "dest": "/contact.html" },
    { "src": "/business.html",           "dest": "/business.html" },
    { "src": "/feedback.html",           "dest": "/feedback.html" },
    { "src": "/bug.html",                "dest": "/bug.html" },
    { "src": "/terms.html",              "dest": "/terms.html" },
    { "src": "/privacy.html",            "dest": "/privacy.html" },
    { "src": "/theme.js",                "dest": "/theme.js" },
    { "src": "/theme-vars.css",          "dest": "/theme-vars.css" },
    { "src": "/(.*)",                    "dest": "/index.html" }
  ]
}
